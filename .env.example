# Copy to .env and fill in. Never commit .env.
# BCCh BDE API token (free; generate under "Mi cuenta" on si3.bcentral.cl; valid 1 year).
# Wrap in single quotes: tokens contain "$".
BCCH_API_TOKEN=
# https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=
# https://www.banxico.org.mx/SieteAPI/
BANXICO_TOKEN=
# Optional: https://www.eia.gov/opendata/
EIA_API_KEY=
# --- Morning job (deployment) ---
# AgentMail (https://agentmail.to) API key + sending inbox; the report goes to REPORT_TO.
AGENTMAIL_API_KEY=
AGENTMAIL_INBOX=arath-7546@agentmail.to
REPORT_TO=
# GitHub repo (owner/name) whose release "data" holds monitor.duckdb.gz, and a token for it.
DATA_REPO=
GITHUB_TOKEN=
# Deployed app only (Streamlit Cloud secrets): 1 = download the published database on start.
AUTO_PULL_DB=
